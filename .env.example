# --- GenAI: Gemini free tier (https://aistudio.google.com/apikey). Without a key the app runs in clearly-labelled demo mode ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used automatically when the primary model errors or hits the free-tier rate limit
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Bhashini (optional; falls back to browser speech) ---
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Pipeline id for the Bhashini ULCA config call (MeitY default)
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# --- Supabase (optional; preferences stay in localStorage without it) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Institution API ---
# Comma-separated demo keys accepted when Supabase is not configured (hashed at runtime, never logged)
DEMO_API_KEYS=demo-institution-key
